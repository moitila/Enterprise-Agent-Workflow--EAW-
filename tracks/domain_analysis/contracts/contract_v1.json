    "approval/approval_record.json",
    "publication/publication_result.json"
  ],
  "negative_cases": [
    "candidate_changed_after_approval",
    "request_id_mismatch",
    "base_revision_mismatch",
    "mutable_or_missing_revision",
    "unauthorized_destination",
    "digest_mismatch",
    "invalid_handoff",
    "manifest_mismatch",
    "file_hash_mismatch"
  ],
  "proof_limits": ["local", "sequential"]
}
